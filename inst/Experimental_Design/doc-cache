statistics: n = sampsizepwr ( testtype , params , p1 )
statistics: n = sampsizepwr ( testtype , params , p1 , power )
statistics: power = sampsizepwr ( testtype , params , p1 , [], n )
statistics: p1 = sampsizepwr ( testtype , params , [], power , n )
