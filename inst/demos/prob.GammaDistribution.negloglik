%!demo
%! ## Compute the negative loglikelihood for a fitted Gamma distribution
%! rng (42);
%! randg ('state', 42);
%! rande ('state', 42);
%! randp ('state', 42);
%! pd = makedist ("Gamma", "a", 2, "b", 1)
%! data = gamrnd (2, 1, 100, 1);
%! pd_fitted = fitdist (data, "Gamma")
%! nlogL = negloglik (pd_fitted)
%!
%! ## This is useful for assessing the fit of a Gamma distribution to
%! ## data, lower values indicate a better fit.
