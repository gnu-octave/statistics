%!demo
%! ## Compute the negative loglikelihood for a fitted Extreme Value distribution
%! rng (42);
%! randg ('state', 42);
%! rande ('state', 42);
%! randp ('state', 42);
%! pd = makedist ("ExtremeValue", "mu", 0, "sigma", 1)
%! data = random (pd, 100, 1);
%! pd_fitted = fitdist (data, "ExtremeValue")
%! nlogL = negloglik (pd_fitted)
%!
%! ## This is useful for assessing the fit of an Extreme Value distribution to
%! ## data, lower values indicate a better fit.
