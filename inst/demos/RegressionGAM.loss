%!demo
%! ## 1. The mean squared error of the model on its own training data
%!
%! load fisheriris
%! X = meas(:,1:3);
%! Y = meas(:,4);
%! mdl = fitrgam (X, Y);
%!
%! ## resubLoss asks the same question without handing the data back in
%! [loss(mdl, X, Y), resubLoss(mdl)]

%!demo
%! ## 2. Interaction terms lower the loss on this data
%!
%! load fisheriris
%! X = meas(:,1:3);
%! Y = meas(:,4);
%!
%! ## 'all' fits every pairwise term on top of the additive ones
%! [resubLoss(fitrgam (X, Y)), resubLoss(fitrgam (X, Y, 'Interactions', 'all'))]

%!demo
%! ## 3. A loss function of your own, taking the truth, the fit and the weights
%!
%! load fisheriris
%! X = meas(:,1:3);
%! Y = meas(:,4);
%! mdl = fitrgam (X, Y);
%!
%! ## Mean absolute error instead of mean squared error
%! mae = @(y, yfit, w) sum (w .* abs (y - yfit));
%! [loss(mdl, X, Y), loss(mdl, X, Y, 'LossFun', mae)]

%!demo
%! ## 4. Scoring a table
%!
%! load fisheriris
%! T = table (meas(:,2), meas(:,3), meas(:,4), meas(:,1), ...
%!            'VariableNames', {'SW', 'PL', 'PW', 'SL'});
%! mdl = fitrgam (T, 'SL');
%!
%! ## The response is named by its column, left out, when it is the variable
%! ## the model was fitted on, or given beside the predictors
%! [loss(mdl, T, 'SL'), loss(mdl, T), loss(mdl, T(:, 1:3), T.SL)]
