%!demo
%! ## Plot the PMF of a Negative Binomial distribution, with parameters R = 5
%! ## and P = 0.5, truncated at [2, 10].  Generate 10000 random samples from
%! ## this truncated distribution and superimpose a histogram of their relative
%! ## frequencies.
%!
%! rng (42);
%! randg ('state', 42);
%! randp ('state', 42);
%! pd = makedist ("NegativeBinomial", "R", 5, "P", 0.5);
%! t = truncate (pd, 2, 10);
%! data = random (t, 10000, 1);
%!
%! ## Relative frequency of each value from 2 to 10
%! centers = 2:10;
%! probs = histc (data, centers) / numel (data);
%!
%! bar (centers, probs, 0.5, "facecolor", [0.6 0.6 1]);
%! hold on
%! plot (centers, pdf (t, centers), 'r-', "linewidth", 2);
%! hold off
%! title ("Negative Binomial distribution (R = 5, P = 0.5) truncated at [2, 10]")
%! legend ("Histogram", "Truncated PMF")
%!
%! ## This demonstrates truncating a Negative Binomial distribution to a
%! ## specific range and checking the result against random samples.
