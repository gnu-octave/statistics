%!demo
%! ## 1. The mean margin over a data set
%!
%! load fisheriris
%! mdl = fitcnet (meas, species, 'IterationLimit', 150);
%!
%! ## edge is the average of what margin returns
%! [edge(mdl, meas, species), mean(margin (mdl, meas, species))]

%!demo
%! ## 2. Weighting the observations
%!
%! load fisheriris
%! mdl = fitcnet (meas, species, 'IterationLimit', 150);
%!
%! ## Weighting one species only gives the edge over that species alone.
%! ## The weights are normalised before they are applied
%! classes = unique (species);
%! e = zeros (1, 3);
%! for k = 1:3
%!   w = double (strcmp (species, classes{k}));
%!   e(k) = edge (mdl, meas, species, 'Weights', w);
%! endfor
%! bar ([edge(mdl, meas, species), e]);
%! set (gca, 'xticklabel', {'all', classes{:}});
%! ylabel ('Edge');
%! title ('Edge overall and within each species');

%!demo
%! ## 3. Scoring a table
%!
%! load fisheriris
%! T = table (meas(:,1), meas(:,2), meas(:,3), meas(:,4), ...
%!            'VariableNames', {'SL', 'SW', 'PL', 'PW'});
%! T.Species = categorical (species);
%! mdl = fitcnet (T, 'Species');
%!
%! ## The response is named by its column, left out, when it is the variable
%! ## the model was fitted on, or given beside the predictors
%! [edge(mdl, T, 'Species'), edge(mdl, T), edge(mdl, T(:, 1:4), T.Species)]
