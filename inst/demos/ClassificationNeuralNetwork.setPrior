%!demo
%! ## 1. The prior follows the training frequencies
%!
%! load fisheriris
%! mdl = fitcnet (meas, species, 'IterationLimit', 200);
%!
%! ## Fifty of each species, so the empirical prior is uniform here
%! table (mdl.ClassNames, mdl.Prior, 'VariableNames', {'Class', 'Prior'})

%!demo
%! ## 2. An unbalanced training set gives an unbalanced prior
%!
%! load fisheriris
%! keep = [1:50, 51:70, 101:110];
%! mdl = fitcnet (meas(keep,:), species(keep), 'IterationLimit', 200);
%!
%! ## empirical follows the counts, uniform ignores them
%! p = [mdl.Prior, setPrior(mdl, 'uniform').Prior];
%! bar (p);
%! set (gca, 'xticklabel', mdl.ClassNames);
%! ylabel ('Prior probability');
%! legend ({'empirical', 'uniform'});
%! title ('Prior from the data against a flat prior');
